digraph "General Optimization Tools"
{
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=box];
  rankdir=LR;
  Node1 [label="General Optimization\l Tools",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="This group contains some general optimization frameworks implemented in LEMON."];
  Node3 [label="Metaheuristics",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$group__metah.html",tooltip="Metaheuristics for LEMON library."];
  Node2 [label="LP and MIP Solvers",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$group__lp__group.html",tooltip="LP and MIP solver interfaces for LEMON."];
  Node1->Node2 [shape=plaintext, dir="back", style="solid"];
  Node1->Node3 [shape=plaintext, dir="back", style="solid"];
}
