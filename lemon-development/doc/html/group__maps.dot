digraph "Maps"
{
  edge [fontname="Helvetica",fontsize="10",labelfontname="Helvetica",labelfontsize="10"];
  node [fontname="Helvetica",fontsize="10",shape=box];
  rankdir=LR;
  Node3 [label="Graph Maps",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$group__graph__maps.html",tooltip="Special graph-related maps."];
  Node4 [label="Map Adaptors",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$group__map__adaptors.html",tooltip="Tools to create new maps from existing ones."];
  Node1 [label="Maps",height=0.2,width=0.4,color="black", fillcolor="grey75", style="filled", fontcolor="black",tooltip="Map structures implemented in LEMON."];
  Node2 [label="Data Structures",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$group__datas.html",tooltip=" "];
  Node2->Node1 [shape=plaintext, dir="back", style="solid"];
  Node1->Node3 [shape=plaintext, dir="back", style="solid"];
  Node1->Node4 [shape=plaintext, dir="back", style="solid"];
}
