# ============================================================
#  LEMONSolver — .gitignore
# ============================================================

# --- Project-specific ---------------------------------------
# Local LEMON build & install tree
lemon-development/build
lemon-development/bin
lemon-development/include
lemon-development/lib
lemon-development/share

# Locally regenerated formatter configs
include/.clang-format
src/.clang-format

# LEMON license file dropped into the tree by their install
LICENSE

# Data directories
data/dmx/*.dmx
data/nc4

# --- C/C++ build artifacts ----------------------------------
*.o
*.obj
*.d
*.gch
*.pch
*.a
*.lib
*.la
*.lai
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.dSYM/
*.pdb
*.idb
*.ilk
*.map
*.exp
*.gcno
*.gcda

# --- CMake --------------------------------------------------
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
CMakeScripts/
CMakeLists.txt.user
cmake_install.cmake
install_manifest.txt
compile_commands.json
CTestTestfile.cmake
Testing/
_deps/

# --- IDEs ---------------------------------------------------
.idea/
.vscode/
*.iml
*.iws
out/

# --- OS junk ------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*~
.directory
.fuse_hidden*
.nfs*
